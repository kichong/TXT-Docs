{
  "name": "txt-docs",
  "productName": "TXT Docs",
  "version": "0.3.8",
  "description": "A minimal local-first Windows word processor for DOCX, Markdown, and plain-text documents.",
  "main": "dist/main/main.cjs",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kichong/TXT-Docs.git"
  },
  "homepage": "https://github.com/kichong/TXT-Docs",
  "scripts": {
    "start": "concurrently -k \"pnpm dev:renderer\" \"pnpm dev:main\" \"pnpm dev:preload\" \"pnpm dev:electron\"",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "dev:main": "vite build --watch --config vite.main.config.ts",
    "dev:preload": "vite build --watch --config vite.preload.config.ts",
    "dev:electron": "wait-on tcp:5173 dist/main/main.cjs dist/preload/preload.cjs && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "pnpm clean && vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts && vite build --config vite.renderer.config.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('release',{recursive:true,force:true})\"",
    "icons": "node scripts/create-icons.mjs",
    "package": "pnpm build && electron-builder --dir",
    "make": "pnpm build && electron-builder --publish never",
    "release:github": "pnpm build && electron-builder --win nsis --x64 --publish always",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test"
  },
  "author": "TXT Docs",
  "license": "Apache-2.0",
  "build": {
    "appId": "com.txtdocs.app",
    "productName": "TXT Docs",
    "asar": true,
    "electronUpdaterCompatibility": ">=2.16",
    "publish": [
      {
        "provider": "github",
        "owner": "kichong",
        "repo": "TXT-Docs",
        "releaseType": "draft"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "fileAssociations": [
      {
        "ext": "docx",
        "name": "Word document",
        "role": "Editor"
      },
      {
        "ext": "doc",
        "name": "Legacy Word document",
        "role": "Editor"
      },
      {
        "ext": "txt",
        "name": "Plain text document",
        "role": "Editor"
      },
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown document",
        "role": "Editor"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "TXT-Docs-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@tiptap/core": "^3.29.1",
    "@tiptap/extension-color": "^3.29.1",
    "@tiptap/extension-font-family": "^3.29.1",
    "@tiptap/extension-highlight": "^3.29.1",
    "@tiptap/extension-image": "^3.29.1",
    "@tiptap/extension-link": "^3.29.1",
    "@tiptap/extension-subscript": "^3.29.1",
    "@tiptap/extension-superscript": "^3.29.1",
    "@tiptap/extension-table": "^3.29.1",
    "@tiptap/extension-table-cell": "^3.29.1",
    "@tiptap/extension-table-header": "^3.29.1",
    "@tiptap/extension-table-row": "^3.29.1",
    "@tiptap/extension-text-align": "^3.29.1",
    "@tiptap/extension-text-style": "^3.29.1",
    "@tiptap/extension-underline": "^3.29.1",
    "@tiptap/pm": "^3.29.1",
    "@tiptap/react": "^3.29.1",
    "@tiptap/starter-kit": "^3.29.1",
    "docx": "^9.7.1",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.10.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^2.1.8",
    "playwright": "^1.62.0",
    "sharp": "^0.34.5",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  }
}
